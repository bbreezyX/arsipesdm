# Node.js 24+. Copy to .env.local and set the PostgreSQL connection URL.
DATABASE_URL=
DEMO_ENABLED=false
ADMIN_EMAIL=operator@esdm.local
# Needed only to bootstrap an empty database. Existing migrated accounts are retained.
ADMIN_PASSWORD=
# Optional public application URL, e.g. https://arsipesdm.up.railway.app
# APP_ORIGIN=
# Separate database for integration tests; tests use disposable schemas.
# TEST_DATABASE_URL=
